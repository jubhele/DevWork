{
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    /* Module system */
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Paths (no baseUrl) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* JSX (Next.js handles transform) */
    "jsx": "preserve",

    /* Interop & compatibility */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Performance */
    "incremental": true,

    /* Node types if needed globally */
    "types": ["node"]
  }
}