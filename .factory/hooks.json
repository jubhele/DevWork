            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"C:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -HookEvent SessionStart -Provider \"Factory Droid\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
