	partition SafetyFiles = m
		mode: import
		source =
				let
					Source = MySQL.Database(#"Database Server", #"Database Name", [ReturnSingleDatabase=true]),
					Data = Source{[Schema=#"Database Name",Item="bf_safety_files"]}[Data],
					Selected = Table.SelectColumns(Data, {"id", "ref_id", "contractor", "audit_date", "region", "status", "is_active", "score", "band"}, MissingField.UseNull),
					Typed = Table.TransformColumnTypes(Selected, {{"score", type number}, {"audit_date", type datetime}, {"is_active", Int64.Type}})
				in
					Typed

	annotation PBI_ResultType = Table

