		formatString: 0
		lineageTag: ba000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: id

	column ref_id
		dataType: string
		lineageTag: ba000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: ref_id

	column contractor
		dataType: string
		lineageTag: ba000000-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: contractor

	column audit_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: ba000000-0000-4000-8000-000000000005
		summarizeBy: none
		sourceColumn: audit_date

	column region
		dataType: string
		lineageTag: ba000000-0000-4000-8000-000000000006
		summarizeBy: none
		sourceColumn: region

	column status
		dataType: string
		lineageTag: ba000000-0000-4000-8000-000000000007
