model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ZA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Clients","Callouts","Quotes","Invoices","Payments","Users","SafetyFiles","Tasks","Transactions","Database Server","Database Name"]

ref table Clients
ref table Callouts
ref table Quotes
ref table Invoices
ref table Payments
ref table Users
ref table Date
ref table Metrics
ref table SafetyFiles
ref table Tasks
ref table Transactions

ref role Portal_Admin
ref role Portal_Manager
ref role Portal_Operations
ref role Portal_Client

ref cultureInfo en-US

