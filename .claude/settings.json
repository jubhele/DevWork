{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\.claude\\scripts\\session-log-update.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Updating session log..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\.claude\\scripts\\session-log-reminder.ps1\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Checking session log..."
          }
        ]
      }
    ]
  }
}
