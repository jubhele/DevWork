{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -Event SessionStart -Provider \"Claude Code\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Initializing constitutional session..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -Event UserPromptSubmit -Provider \"Claude Code\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Running constitution preflight..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch|Create",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -Event PreChange -Provider \"Claude Code\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Checking constitution preflight..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -Event Stop -Provider \"Claude Code\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Checking constitutional session..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File \"c:\\DevWork\\scripts\\governance\\constitution-hook.ps1\" -Event PostChange -Provider \"Claude Code\"",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "Checking session log..."
          }
        ]
      }
    ]
  }
}
