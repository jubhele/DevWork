# DevWork Workspace Secret Vault
# ---------------------------------------------------------------------------
# Setup: copy this file to .env and fill in real values.
# Namespace rule: GBL_* = workspace global, BF_* = BlackFire, AI_* = Astute Insights.
# App-local .env files are generated mirrors, never independent secret stores.
# ---------------------------------------------------------------------------

# Global AI provider keys (primary + fallback slots)
GBL_ANTHROPIC_API_KEY=
GBL_ANTHROPIC_API_KEY_2=
GBL_ANTHROPIC_API_KEY_3=
GBL_OPENAI_API_KEY=
GBL_OPENAI_API_KEY_2=
GBL_OPENAI_API_KEY_3=
GBL_GOOGLE_AI_API_KEY=
GBL_GOOGLE_AI_API_KEY_2=
GBL_GOOGLE_AI_API_KEY_3=
GBL_KIMI_AI_API_KEY=
GBL_KIMI_AI_API_KEY_2=
GBL_KIMI_AI_API_KEY_3=

# Global workspace identity
GBL_OWNER_NAME=
GBL_OWNER_EMAIL=
GBL_TIMEZONE=

# Global Git identity
GBL_GIT_PROVIDER=
GBL_GIT_USER=
GBL_GIT_EMAIL=

# Global account-registration identity
