# DevWork Workspace Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP: Copy this file to .env and fill in real values.
#        cp .env.example .env
#
# RULES:
#   - .env is in .gitignore — NEVER commit it
#   - This file (.env.example) IS committed — keep all keys here, values empty
#   - No secrets, passwords, or API keys anywhere else in the codebase
#   - Umlindi will POLICY_BLOCK any commit with hardcoded credentials
# ─────────────────────────────────────────────────────────────────────────────


# ─── LLM API KEYS ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=


# ─── BLACKFIRE PORTAL (PHP) ──────────────────────────────────────────────────
BF_DB_HOST=
BF_DB_PORT=3306
BF_DB_NAME=
BF_DB_USER=
BF_DB_PASSWORD=

BF_APP_URL=
BF_APP_SECRET_KEY=
BF_JWT_SECRET=
BF_SESSION_LIFETIME=3600

BF_SMTP_HOST=
BF_SMTP_PORT=587
BF_SMTP_USER=
BF_SMTP_PASSWORD=
BF_MAIL_FROM=

BF_UPLOAD_PATH=uploads/
BF_UPLOAD_MAX_SIZE=10485760


# ─── UMLILO PORTAL (Next.js) ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
UMLILO_API_SECRET=
UMLILO_SESSION_SECRET=

# Vercel deployment
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=


# ─── AGENT WORKFORCE ─────────────────────────────────────────────────────────
AGENT_DEFAULT_PROVIDER=claude
AGENT_COST_TIER_MAX=2
AGENT_SESSION_LOG_PATH=sessions/
AGENT_MEMORY_PATH=memory/


# ─── OBSERVABILITY (Pattern 21) ──────────────────────────────────────────────
# DEBUG_MODE=true enables structured debug logs to sessions/debug_{TASK_ID}.log
# NEVER set DEBUG_MODE=true in production — Umlindi will POLICY_BLOCK it
DEBUG_MODE=false
TASK_ID=


# ─── EXTERNAL SERVICES ───────────────────────────────────────────────────────
# Add third-party service keys below as they are introduced.
# Format: {SERVICE_NAME}_{KEY_TYPE}=
# Example:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
