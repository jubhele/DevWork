# BlackFire Solutions — API Directory .htaccess
# Purpose: Security hardening for /api/ endpoints only.
# Routing is handled by the root .htaccess — do NOT add index.php routing here.

Options -Indexes
Options -MultiViews

# ── Block sensitive files ──────────────────────────────────────────────
<FilesMatch "\.(py|sql|log|md|bak|env|ini|sh|key)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block _archive folder from web access
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^_archive/ - [L,F]
</IfModule>

# ── PHP hardening ──────────────────────────────────────────────────────
php_flag display_errors Off
php_flag log_errors On
php_flag expose_php Off

# ── Security headers ───────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ── Allow CORS preflight for API ───────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# ── Block known vulnerability scanners ────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|dirbuster|gobuster|wfuzz|nuclei|acunetix|nessus|openvas|burpsuite|havij|hydra|metasploit) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|MJ12bot|DotBot|BLEXBot|DataForSeoBot|PetalBot|serpstatbot) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ── Block common attack patterns ───────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table) [NC,OR]
    RewriteCond %{QUERY_STRING} (<script|javascript:|vbscript:|onload=|onerror=) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode) [NC]
    RewriteRule .* - [F,L]
</IfModule>
