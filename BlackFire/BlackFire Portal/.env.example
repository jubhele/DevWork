# Copy this file to .env and fill in your values.
# Never commit .env — it contains encrypted credentials.
#
# BF_APP_KEY must NOT go here — set it in cPanel Environment Variables only.
# Use install/encrypt_config.php to generate BF_APP_KEY and BF_DB_PASS_ENC.

BF_DB_HOST=localhost
BF_DB_PORT=3306
BF_DB_NAME=your_database_name
BF_DB_USER=your_database_user
BF_DB_PASS_ENC=<output from install/encrypt_config.php>
