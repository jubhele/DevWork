# ============================================================
# Umlilo Portal — Local development environment template
# Copy to .env and fill in values. NEVER deploy .env to the server —
# production reads secrets from ~/blackfire_secrets.php instead.
# .env must be listed in .gitignore (never commit real values).
# ============================================================

# ── Database ────────────────────────────────────────────────
BF_DB_HOST=localhost
BF_DB_PORT=3306
BF_DB_NAME=
BF_DB_USER=
# Encrypted password (preferred) — produced by install/encrypt_config.php
BF_DB_PASS_ENC=
# Plaintext password — LOCAL DEVELOPMENT ONLY, never on production
BF_DB_PASS=

# ── Application encryption key ──────────────────────────────
# Required to decrypt BF_DB_PASS_ENC. On production this lives in
# cPanel > Environment Variables — never in a file.
BF_APP_KEY=
