<?php
/**
 * BlackFire Portal — Production Secrets Template
 *
 * HOW TO USE:
 *   1. Copy this file to ~/blackfire_secrets.php (one level ABOVE public_html).
 *      The real file must NEVER enter the git repo — it is outside the webroot.
 *   2. Fill in your real values below.
 *   3. Delete this comment block from the real file.
 *
 * WHY define() instead of putenv()?
 *   putenv() is disabled on many Afrihost / shared-hosting PHP installations.
 *   config.php uses cfg_env() which checks getenv() → $_ENV → $_SERVER → defined().
 *   define() is the reliable last-resort fallback on restricted hosts.
 *
 * MULTI-TENANCY NOTE (Phase 1+):
 *   This file stays identical regardless of how many tenants the portal serves.
 *   BF_APP_KEY is the master encryption key — it decrypts:
 *     • The DB password (BF_DB_PASS_ENC below)
 *     • Per-tenant SMTP passwords stored in bf_host_companies.mail_password_enc
 *     • Any other encrypted fields in bf_host_companies
 *   All tenant-specific sensitive data lives in the encrypted DB, not here.
 */

// ── Master encryption key ─────────────────────────────────────────────────────
// Generate with: php -r "echo bin2hex(random_bytes(32));"
// ALL bf_decrypt() calls across the portal use this key.
// If you change this key, all encrypted values in the DB must be re-encrypted.
define('BF_APP_KEY', 'REPLACE_WITH_64_HEX_CHARS');

// ── Database ──────────────────────────────────────────────────────────────────
// BF_DB_PASS_ENC: run encrypt_secrets.php (locally) to get the encrypted value.
define('BF_DB_HOST',     'localhost');
define('BF_DB_PORT',     3306);
define('BF_DB_NAME',     'your_cpanel_db_name');
define('BF_DB_USER',     'your_cpanel_db_user');
define('BF_DB_PASS_ENC', 'REPLACE_WITH_ENCRYPTED_DB_PASSWORD');

// ── SMTP / Mailer ─────────────────────────────────────────────────────────────
// Phase 1+: per-tenant SMTP passwords move to bf_host_companies.mail_password_enc.
// Until then, this is the single shared SMTP password.
define('BF_MAIL_PASS', 'REPLACE_WITH_SMTP_PASSWORD');

// ── Company / Host Identity (Phase 0 only) ────────────────────────────────────
// Set these here for shared-hosting environments where cPanel env vars
// cannot be set (or where putenv() is disabled).
//
// Once bf_host_companies is live (Phase 1), config.php will read from the DB
// row instead — these constants become unused and can be removed at that point.
//
// Alternatively, set these in cPanel > Software > PHP > Environment Variables
// and leave the lines below commented out — cfg_env() will find them via getenv().
define('COMPANY_NAME',       'BlackFire Solutions');
define('COMPANY_LEGAL_NAME', 'Astute Insights Pty Ltd');
define('COMPANY_REG',        '2021/964381/07');
define('COMPANY_VAT',        '4060310358');
define('COMPANY_PHONE',      '073 693 8446');
define('COMPANY_EMAIL',      'accounts@astuteinsights.co.za');
define('COMPANY_ADDR',       '102 Aloeridge 2, Stoneridge Street, Greenstone, 1616');
define('COMPANY_TAGLINE',    'Fire, taught to behave.');
define('COMPANY_LOGO',       './blackfire_logo_transparent.png');
define('INVOICE_PREFIX',     'INV');
define('QUOTE_PREFIX',       'QTE');
define('CALLOUT_PREFIX',     'CO');
define('SESSION_NAME',       'BLKFR_SESSION');
