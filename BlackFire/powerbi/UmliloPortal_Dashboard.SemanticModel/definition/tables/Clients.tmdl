	partition Clients = m
		mode: import
		source =
				let
					Source = MySQL.Database(#"Database Server", #"Database Name", [ReturnSingleDatabase=true]),
					Data = Source{[Schema=#"Database Name",Item="bf_clients"]}[Data],
					Selected = Table.SelectColumns(Data, {"id", "name", "contact_person", "email", "is_active", "created_at"}, MissingField.UseNull),
					Typed = Table.TransformColumnTypes(Selected, {{"is_active", Int64.Type}})
				in
					Typed

	annotation PBI_ResultType = Table

