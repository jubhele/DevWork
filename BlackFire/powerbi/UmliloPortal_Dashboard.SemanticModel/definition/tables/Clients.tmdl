		formatString: 0
		lineageTag: b2000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: id

	column name
		dataType: string
		lineageTag: b2000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: name

	column contact_person
