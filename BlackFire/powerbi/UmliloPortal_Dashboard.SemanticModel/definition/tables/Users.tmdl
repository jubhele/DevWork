table Users
	isHidden
	lineageTag: b7000000-0000-4000-8000-000000000001

	column id
		dataType: int64
		formatString: 0
		lineageTag: b7000000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: id

	column username
		dataType: string
		lineageTag: b7000000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: username

	column email
		dataType: string
		lineageTag: b7000000-0000-4000-8000-000000000004
		summarizeBy: none
		sourceColumn: email

	column role
		dataType: string
		lineageTag: b7000000-0000-4000-8000-000000000005
		summarizeBy: none
