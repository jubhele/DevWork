			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(_pct * 248, "0") & "' height='8' rx='4' fill='%23D48A15'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & FORMAT(_pct * 100, "0") & "%25 of all tasks</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000044
		dataCategory: ImageUrl

	measure 'SVG Net Balance' =
			VAR _n = COALESCE([Net Balance], 0)
			VAR _v = "R" & FORMAT(_n / 1000, "#,0.0") & "k"
			VAR _color = IF(_n >= 0, "%232E7D32", "%23A82A1E")
			VAR _arrow = IF(_n >= 0, "M247 55 l7 -14 l7 14 Z", "M247 41 l7 14 l7 -14 Z")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='" & _color & "'/>" &
			"<circle cx='254' cy='48' r='24' fill='" & _color & "' fill-opacity='0.10'/>" &
			"<path d='" & _arrow & "' fill='" & _color & "'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>NET BALANCE</text>" &
			"<text x='26' y='118' font-family='Segoe UI' font-weight='700' font-size='48' fill='" & _color & "'>" & _v & "</text>" &
			"<line x1='26' y1='140' x2='92' y2='140' stroke='" & _color & "' stroke-width='3'/>" &
			"<text x='26' y='164' font-family='Segoe UI' font-size='13' fill='%234A4638'>Credits - Debits</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-00000000003d
		dataCategory: ImageUrl

