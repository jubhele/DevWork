table Metrics
	lineageTag: b9000000-0000-4000-8000-000000000001

	/// Base measures — validated against live bf_* schema
	measure 'Total Callouts' = COUNTROWS(Callouts)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000010

	measure 'Open Callouts' = CALCULATE(COUNTROWS(Callouts), Callouts[status] IN {"Open", "In Progress"})
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000011

	measure 'Completed Callouts' = CALCULATE(COUNTROWS(Callouts), Callouts[status] IN {"Completed", "Invoiced"})
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000012

	measure 'Emergency Callouts' = CALCULATE(COUNTROWS(Callouts), Callouts[priority] = "Emergency")
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000013

	measure 'Quote Pipeline' = CALCULATE(SUM(Quotes[total_amount]), Quotes[status] IN {"Sent", "Pending Approval", "Approved"})
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000014

	measure 'Quote Conversion %' = DIVIDE(CALCULATE(COUNTROWS(Quotes), Quotes[status] = "Converted"), COUNTROWS(Quotes))
		formatString: 0.0%
		lineageTag: b9000000-0000-4000-8000-000000000015

	measure 'Invoiced Total' = SUM(Invoices[amount])
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000016

	measure 'Paid Total' = CALCULATE(SUM(Invoices[amount]), Invoices[status] = "Paid")
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000017

	measure 'Outstanding Total' = CALCULATE(SUM(Invoices[amount]), Invoices[status] IN {"Sent", "Overdue"})
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000018

	measure 'Overdue Invoices' = COALESCE(CALCULATE(COUNTROWS(Invoices), Invoices[status] = "Overdue"), 0)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000019

	measure 'Payments Received' = CALCULATE(SUM(Payments[amount]), USERELATIONSHIP(Payments[payment_date], 'Date'[Date]))
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-00000000001a

	measure 'Active Clients' = CALCULATE(COUNTROWS(Clients), Clients[is_active] = 1)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-00000000001b

	measure 'Safety Files Count' = COUNTROWS(SafetyFiles)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-00000000001c

	measure 'Avg Safety Score' = AVERAGE(SafetyFiles[score])
		formatString: 0.0
		lineageTag: b9000000-0000-4000-8000-00000000001d

	measure 'Red Band Files' = COALESCE(CALCULATE(COUNTROWS(SafetyFiles), SafetyFiles[band] = "RED"), 0)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-00000000001e

	measure 'Open Tasks' = COALESCE(CALCULATE(COUNTROWS(Tasks), Tasks[status] IN {"Open", "In Progress"}), 0)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-00000000001f

	measure 'Overdue Tasks' = COALESCE(CALCULATE(COUNTROWS(Tasks), Tasks[status] IN {"Open", "In Progress"}, Tasks[due_date] < TODAY()), 0)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000020

	measure 'Completed Tasks' = COALESCE(CALCULATE(COUNTROWS(Tasks), Tasks[status] = "Done"), 0)
		formatString: #,0
		lineageTag: b9000000-0000-4000-8000-000000000021

	measure 'Total Credits' = SUM(Transactions[credit])
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000022

	measure 'Total Debits' = SUM(Transactions[debit])
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000023

	measure 'Net Balance' = SUM(Transactions[credit]) - SUM(Transactions[debit])
		formatString: \R#,0.00
		lineageTag: b9000000-0000-4000-8000-000000000024

	measure 'SVG Open Callouts' =
			VAR _v = FORMAT(COALESCE([Open Callouts], 0), "#,0")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23C94A10'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23C94A10' fill-opacity='0.09'/>" &
			"<path d='M254 35 l9 16 h-18 Z' fill='%23C94A10'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>OPEN CALLOUTS</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='%23C94A10' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>Open %2B In Progress</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000030
		dataCategory: ImageUrl

	measure 'SVG Completed Callouts' =
			VAR _v = FORMAT(COALESCE([Completed Callouts], 0), "#,0")
			VAR _pct = DIVIDE([Completed Callouts], [Total Callouts], 0)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23D48A15'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23D48A15' fill-opacity='0.12'/>" &
			"<path d='M245 48 l7 8 l16 -17' stroke='%23D48A15' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>COMPLETED</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(_pct * 248, "0") & "' height='8' rx='4' fill='%23D48A15'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & FORMAT(_pct * 100, "0") & "%25 of all callouts</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000031
		dataCategory: ImageUrl

	measure 'SVG Emergency Callouts' =
			VAR _v = FORMAT(COALESCE([Emergency Callouts], 0), "#,0")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23A82A1E'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23A82A1E' fill-opacity='0.10'/>" &
			"<path d='M254 34 l12 22 h-24 Z' fill='none' stroke='%23A82A1E' stroke-width='2.5' stroke-linejoin='round'/>" &
			"<rect x='252.7' y='41' width='2.6' height='8' rx='1.3' fill='%23A82A1E'/>" &
			"<circle cx='254' cy='52.5' r='1.8' fill='%23A82A1E'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>EMERGENCY</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%23A82A1E'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='%23A82A1E' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>Priority: Emergency</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000032
		dataCategory: ImageUrl

	measure 'SVG Active Clients' =
			VAR _v = FORMAT(COALESCE([Active Clients], 0), "#,0")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23E06A1A'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23E06A1A' fill-opacity='0.10'/>" &
			"<circle cx='254' cy='42' r='7' fill='none' stroke='%23E06A1A' stroke-width='2.5'/>" &
			"<path d='M242 62 q12 -13 24 0' fill='none' stroke='%23E06A1A' stroke-width='2.5' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>ACTIVE CLIENTS</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='%23E06A1A' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>Contracted and active</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000033
		dataCategory: ImageUrl

	measure 'SVG Invoiced Total' =
			VAR _v = "R" & FORMAT(COALESCE([Invoiced Total], 0) / 1000, "#,0.0") & "k"
			VAR _months = CALCULATETABLE(SUMMARIZE('Date', 'Date'[YearMonth Key]), 'Date'[Date] >= EOMONTH(TODAY(), -6) + 1, 'Date'[Date] <= TODAY())
			VAR _max = MAXX(_months, CALCULATE([Invoiced Total], REMOVEFILTERS('Date'), VALUES('Date'[YearMonth Key])))
			VAR _pts = CONCATENATEX(_months,
				VAR _r = RANKX(_months, 'Date'[YearMonth Key], , ASC)
				VAR _m = CALCULATE([Invoiced Total], REMOVEFILTERS('Date'), VALUES('Date'[YearMonth Key]))
				RETURN (26 + (_r - 1) * 49.6) & "," & (168 - DIVIDE(COALESCE(_m, 0), _max, 0) * 40),
				" ", 'Date'[YearMonth Key], ASC)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23C94A10'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>INVOICED</text>" &
			"<text x='26' y='110' font-family='Segoe UI' font-weight='700' font-size='48' fill='%231A1814'>" & _v & "</text>" &
			"<polygon points='26,168 " & _pts & " 274,168' fill='url(%23spark)'/>" &
			"<polyline points='" & _pts & "' fill='none' stroke='%23C94A10' stroke-width='3' stroke-linejoin='round' stroke-linecap='round'/>" &
			"<text x='274' y='48' text-anchor='end' font-family='Segoe UI' font-size='12' fill='%237A7566'>6-month trend</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000034
		dataCategory: ImageUrl

	measure 'SVG Paid Total' =
			VAR _v = "R" & FORMAT(COALESCE([Paid Total], 0) / 1000, "#,0.0") & "k"
			VAR _months = CALCULATETABLE(SUMMARIZE('Date', 'Date'[YearMonth Key]), 'Date'[Date] >= EOMONTH(TODAY(), -6) + 1, 'Date'[Date] <= TODAY())
			VAR _max = MAXX(_months, CALCULATE([Payments Received], REMOVEFILTERS('Date'), VALUES('Date'[YearMonth Key])))
			VAR _pts = CONCATENATEX(_months,
				VAR _r = RANKX(_months, 'Date'[YearMonth Key], , ASC)
				VAR _m = CALCULATE([Payments Received], REMOVEFILTERS('Date'), VALUES('Date'[YearMonth Key]))
				RETURN (26 + (_r - 1) * 49.6) & "," & (168 - DIVIDE(COALESCE(_m, 0), _max, 0) * 40),
				" ", 'Date'[YearMonth Key], ASC)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23D48A15'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>PAID</text>" &
			"<text x='26' y='110' font-family='Segoe UI' font-weight='700' font-size='48' fill='%231A1814'>" & _v & "</text>" &
			"<polygon points='26,168 " & _pts & " 274,168' fill='url(%23spark)'/>" &
			"<polyline points='" & _pts & "' fill='none' stroke='%23D48A15' stroke-width='3' stroke-linejoin='round' stroke-linecap='round'/>" &
			"<text x='274' y='48' text-anchor='end' font-family='Segoe UI' font-size='12' fill='%237A7566'>6-month trend</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000035
		dataCategory: ImageUrl

	measure 'SVG Outstanding Total' =
			VAR _o = COALESCE([Outstanding Total], 0)
			VAR _v = "R" & FORMAT(_o / 1000, "#,0.0") & "k"
			VAR _pct = DIVIDE(_o, [Invoiced Total], 0)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23A82A1E'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23A82A1E' fill-opacity='0.10'/>" &
			"<circle cx='254' cy='48' r='10' fill='none' stroke='%23A82A1E' stroke-width='2.5'/>" &
			"<path d='M254 41 l0 7 l5 3' stroke='%23A82A1E' stroke-width='2.5' fill='none' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>OUTSTANDING</text>" &
			"<text x='26' y='118' font-family='Segoe UI' font-weight='700' font-size='48' fill='%231A1814'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(_pct * 248, "0") & "' height='8' rx='4' fill='%23A82A1E'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & FORMAT(_pct * 100, "0.0") & "%25 of invoiced awaiting payment</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000036
		dataCategory: ImageUrl

	measure 'SVG Overdue Invoices' =
			VAR _n = COALESCE([Overdue Invoices], 0)
			VAR _v = FORMAT(_n, "#,0")
			VAR _color = IF(_n > 0, "%23A82A1E", "%232E7D32")
			VAR _msg = IF(_n > 0, "Requires follow-up", "All invoices current")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='" & _color & "'/>" &
			"<circle cx='254' cy='48' r='24' fill='" & _color & "' fill-opacity='0.10'/>" &
			"<rect x='245' y='39' width='18' height='20' rx='2' fill='none' stroke='" & _color & "' stroke-width='2.5'/>" &
			"<line x1='249.5' y1='35' x2='249.5' y2='42' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<line x1='258.5' y1='35' x2='258.5' y2='42' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>OVERDUE INVOICES</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='" & _color & "'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='" & _color & "' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & _msg & "</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000037
		dataCategory: ImageUrl

	measure 'SVG Quote Pipeline' =
			VAR _v = "R" & FORMAT(COALESCE([Quote Pipeline], 0) / 1000, "#,0.0") & "k"
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23E06A1A'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23E06A1A' fill-opacity='0.10'/>" &
			"<path d='M244 57 l7 -9 l5 4 l8 -12' fill='none' stroke='%23E06A1A' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/>" &
			"<path d='M259 39 h6 v6' fill='none' stroke='%23E06A1A' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>QUOTE PIPELINE</text>" &
			"<text x='26' y='118' font-family='Segoe UI' font-weight='700' font-size='48' fill='%231A1814'>" & _v & "</text>" &
			"<line x1='26' y1='140' x2='92' y2='140' stroke='%23E06A1A' stroke-width='3'/>" &
			"<text x='26' y='164' font-family='Segoe UI' font-size='13' fill='%234A4638'>Sent / Pending / Approved</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000038
		dataCategory: ImageUrl

	measure 'SVG Quote Conversion' =
			VAR _pct = COALESCE([Quote Conversion %], 0)
			VAR _v = FORMAT(_pct * 100, "0.0") & "%25"
			VAR _deg = _pct * 360
			VAR _rad = RADIANS(_deg - 90)
			VAR _x = 254 + 20 * COS(_rad)
			VAR _y = 48 + 20 * SIN(_rad)
			VAR _large = IF(_deg > 180, 1, 0)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23D48A15'/>" &
			"<circle cx='254' cy='48' r='20' fill='none' stroke='%23EDE8DE' stroke-width='7'/>" &
			"<path d='M254 28 A20 20 0 " & _large & " 1 " & FORMAT(_x, "0.0") & " " & FORMAT(_y, "0.0") & "' fill='none' stroke='%23C94A10' stroke-width='7' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>QUOTE CONVERSION</text>" &
			"<text x='26' y='118' font-family='Segoe UI' font-weight='700' font-size='50' fill='%231A1814'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(_pct * 248, "0") & "' height='8' rx='4' fill='%23C94A10'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>Quotes converted to invoices</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000039
		dataCategory: ImageUrl

	measure 'SVG Avg Safety Score' =
			VAR _s = COALESCE([Avg Safety Score], 0)
			VAR _v = FORMAT(_s, "0.0")
			VAR _color = IF(_s >= 80, "%232E7D32", IF(_s >= 60, "%23E06A1A", "%23A82A1E"))
			VAR _band = IF(_s >= 80, "GREEN band", IF(_s >= 60, "ORANGE band", "RED band"))
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='" & _color & "'/>" &
			"<circle cx='254' cy='48' r='24' fill='" & _color & "' fill-opacity='0.10'/>" &
			"<path d='M254 34 l11 6 v9 q0 9 -11 13 q-11 -4 -11 -13 v-9 Z' fill='none' stroke='" & _color & "' stroke-width='2.5' stroke-linejoin='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>AVG SAFETY SCORE</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='" & _color & "'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(DIVIDE(_s, 100, 0) * 248, "0") & "' height='8' rx='4' fill='" & _color & "'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & _band & " compliance</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-00000000003a
		dataCategory: ImageUrl

	measure 'SVG Red Band Files' =
			VAR _n = COALESCE([Red Band Files], 0)
			VAR _v = FORMAT(_n, "#,0")
			VAR _color = IF(_n > 0, "%23A82A1E", "%232E7D32")
			VAR _msg = IF(_n > 0, "High-risk files need review", "No red band files")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='" & _color & "'/>" &
			"<circle cx='254' cy='48' r='24' fill='" & _color & "' fill-opacity='0.10'/>" &
			"<path d='M244 37 h20 v26 h-20 Z' fill='none' stroke='" & _color & "' stroke-width='2.5'/>" &
			"<line x1='249' y1='45' x2='259' y2='45' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<line x1='249' y1='53' x2='259' y2='53' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>RED BAND FILES</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='" & _color & "'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='" & _color & "' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & _msg & "</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000042
		dataCategory: ImageUrl

	measure 'SVG Safety Files' =
			VAR _v = FORMAT(COALESCE([Safety Files Count], 0), "#,0")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23C94A10'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23C94A10' fill-opacity='0.10'/>" &
			"<path d='M242 41 q12 -10 24 0 v11 q0 9 -12 14 q-12 -5 -12 -14 Z' fill='none' stroke='%23C94A10' stroke-width='2.5' stroke-linejoin='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>SAFETY FILES</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='%23C94A10' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>Audited contractor files</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-000000000043
		dataCategory: ImageUrl

	measure 'SVG Open Tasks' =
			VAR _v = FORMAT(COALESCE([Open Tasks], 0), "#,0")
			VAR _pct = DIVIDE([Open Tasks], [Total Tasks], 0)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23C94A10'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23C94A10' fill-opacity='0.09'/>" &
			"<rect x='244' y='38' width='20' height='3.5' rx='1.75' fill='%23C94A10'/>" &
			"<rect x='244' y='46.5' width='20' height='3.5' rx='1.75' fill='%23C94A10' fill-opacity='0.7'/>" &
			"<rect x='244' y='55' width='13' height='3.5' rx='1.75' fill='%23C94A10' fill-opacity='0.4'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>OPEN TASKS</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='%231A1814'>" & _v & "</text>" &
			"<rect x='26' y='142' width='248' height='8' rx='4' fill='%23EDE8DE'/>" &
			"<rect x='26' y='142' width='" & FORMAT(_pct * 248, "0") & "' height='8' rx='4' fill='%23C94A10'/>" &
			"<text x='26' y='168' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & FORMAT(_pct * 100, "0") & "%25 of all tasks</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-00000000003b
		dataCategory: ImageUrl

	measure 'SVG Overdue Tasks' =
			VAR _n = COALESCE([Overdue Tasks], 0)
			VAR _v = FORMAT(_n, "#,0")
			VAR _color = IF(_n > 0, "%23A82A1E", "%232E7D32")
			VAR _msg = IF(_n > 0, "Past due date — action needed", "Nothing overdue")
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='" & _color & "'/>" &
			"<circle cx='254' cy='48' r='24' fill='" & _color & "' fill-opacity='0.10'/>" &
			"<circle cx='254' cy='48' r='11' fill='none' stroke='" & _color & "' stroke-width='2.5'/>" &
			"<line x1='254' y1='41' x2='254' y2='49' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<line x1='254' y1='49' x2='259' y2='52' stroke='" & _color & "' stroke-width='2.5' stroke-linecap='round'/>" &
			"<text x='26' y='48' font-family='Segoe UI' font-size='13' letter-spacing='3' fill='%237A7566'>OVERDUE TASKS</text>" &
			"<text x='26' y='124' font-family='Segoe UI' font-weight='700' font-size='60' fill='" & _color & "'>" & _v & "</text>" &
			"<line x1='26' y1='144' x2='92' y2='144' stroke='" & _color & "' stroke-width='3'/>" &
			"<text x='26' y='166' font-family='Segoe UI' font-size='13' fill='%234A4638'>" & _msg & "</text>" &
			"</svg>"
		lineageTag: b9000000-0000-4000-8000-00000000003c
		dataCategory: ImageUrl

	measure 'SVG Completed Tasks' =
			VAR _v = FORMAT(COALESCE([Completed Tasks], 0), "#,0")
			VAR _pct = DIVIDE([Completed Tasks], [Total Tasks], 0)
			RETURN
			[SVG_CardOpen] &
			"<path d='M0 24 L0 162 Q0 172 6 172 L6 14 Q0 14 0 24 Z' fill='%23D48A15'/>" &
			"<circle cx='254' cy='48' r='24' fill='%23D48A15' fill-opacity='0.12'/>" &
