	/// SVG card chrome — 300x200 canvas, BlackFire light gradient + sparkline gradient defs
	measure SVG_CardOpen =
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 188'>" &
			"<defs>" &
			"<linearGradient id='bg' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23FFFFFF'/><stop offset='1' stop-color='%23FBF7F0'/></linearGradient>" &
			"<linearGradient id='spark' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23C94A10' stop-opacity='0.25'/><stop offset='1' stop-color='%23C94A10' stop-opacity='0'/></linearGradient>" &
			"</defs>" &
			"<rect x='1' y='1' width='298' height='186' rx='14' fill='url(%23bg)' stroke='%23C8C1B3'/>"
		isHidden
		lineageTag: b9000000-0000-4000-8000-000000000041

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b9000000-0000-4000-8000-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition Metrics = calculated
		mode: import
		source = {BLANK()}

