table Date
	lineageTag: b8000000-0000-4000-8000-000000000001
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: b8000000-0000-4000-8000-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: b8000000-0000-4000-8000-000000000003
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b8000000-0000-4000-8000-000000000004
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		lineageTag: b8000000-0000-4000-8000-000000000005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'YearMonth Key'

	column 'YearMonth Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b8000000-0000-4000-8000-000000000006
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth Key]

	partition Date = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2024, 1, 1), DATE(YEAR(TODAY()) + 1, 12, 31)), "Year", YEAR([Date]), "Month Number", MONTH([Date]), "Month", FORMAT([Date], "MMM yyyy"), "YearMonth Key", YEAR([Date]) * 100 + MONTH([Date]))

	annotation PBI_ResultType = Table

