# ─── LLM API KEYS ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── DATABASE ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=govtender
DB_USER=govtender
DB_PASSWORD=

# ─── REDIS (Celery broker) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET_KEY=
APP_JWT_SECRET=

# ─── CREDENTIAL VAULT ────────────────────────────────────────────────────────
# Master key used to derive per-tenant portal credential encryption keys
VAULT_MASTER_SECRET=

# ─── NEXT.JS FRONTEND ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SCOUT=
STRIPE_PRICE_RESPOND=
STRIPE_PRICE_COMMAND=

# ─── EMAIL (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@govtender.co.za

# ─── STORAGE ─────────────────────────────────────────────────────────────────
STORAGE_PATH=uploads/
# For production S3-compatible (Hetzner Object Storage):
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=govtender-proposals

# ─── AGENT WORKFORCE ─────────────────────────────────────────────────────────
AGENT_DEFAULT_PROVIDER=claude
AGENT_COST_TIER_MAX=2
AGENT_SESSION_LOG_PATH=sessions/
AGENT_MEMORY_PATH=memory/

# ─── OBSERVABILITY (Pattern 21) ──────────────────────────────────────────────
# NEVER set DEBUG_MODE=true in production
DEBUG_MODE=false
TASK_ID=
