# Project subfolders no longer exist under DevWork — they live as sibling repos at c:\Projects\.
# These stale exclusion patterns from the pre-restructure nested layout are kept only for the
# unrelated legacy "BlackFire Portal" folder (space in name, no .git) that still sits at DevWork
# root and predates the BlackFire project repo entirely — see
# docs/plan_devwork_template_boundary_restructure.md for the restructure history.

# Sensitive data — never commit
.env
.env.enc
*.env.enc
*.key
chatsessions/*.jsonl
sessions/system_chatsessions/*.jsonl
*.env.local
config.local.*

# Timestamped backup folders
**/_backups/

# Root-level backup folder
/_backups/

# Scratch/test artifacts
**/test_*.docx

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# Editor artifacts
.vscode/settings.json
*.code-workspace

# Node
node_modules/
npm-debug.log*

# Build artifacts
dist/
build/
*.min.js
*.min.css
.next/
tsconfig.tsbuildinfo
next-env.d.ts

# Temporary/investigation files — always use c:\DevWork\temp\
/temp/
*.tmp
*.bak
*.swp

# Windows PowerShell
*.ps1.bak

# gstack temp
/tmp/gstack-*

# Local runtime data — never commit
/.pnpm-store/
/mysql-data/
.gstack/
OllamaSetup.exe
*.exe
*.zip
*.bin
